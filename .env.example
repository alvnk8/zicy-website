# Free diagnostic backend base URL, read by src/components/FreeDiagnostic.astro
# (import.meta.env.PUBLIC_DIAGNOSTIC_API_BASE). Must be a PUBLIC_ var so Astro
# exposes it client-side. Leave it unset in dev so requests fall back to
# same-origin and are handled by DIAGNOSTIC_API_TARGET below.
#   production: https://api.zicy.com
#   preview:    https://staging-api.zicy.com
#PUBLIC_DIAGNOSTIC_API_BASE=https://api.zicy.com

# Dev-only: upstream target for the local /api/brand-intelligence proxy
# (src/dev/diagnostic-api-proxy.ts), used when PUBLIC_DIAGNOSTIC_API_BASE is unset.
DIAGNOSTIC_API_TARGET=http://localhost:8000
