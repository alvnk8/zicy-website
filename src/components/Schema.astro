---
// Single owner for ALL sitewide JSON-LD. Imported once by BaseLayout, so this graph
// renders identically on every page (all 82 routes, including the /legal pages, which
// previously emitted no JSON-LD at all). Page-level nodes (FAQPage, Article, Service, the
// Chrome-extension app, per-page product entity pages) live in their own pages and are
// deliberately NOT defined here.
//
// The canonical Organization and Brand nodes (orgNode/brandNode, from ../lib/schema) are
// spliced into every page's graph. Repeating the same @id and content on every page is the
// documented pattern for a sitewide entity — it is not fragmentation; fragmentation is
// conflicting descriptions of the same @id, which byte-identical repetition cannot produce.
//
// Person nodes (Ritu, Peter) are NOT emitted here — see lib/schema.ts's comment on
// rituPersonNode/peterPersonNode: full node on /about plus any article page that names them as
// byline author, @id reference only elsewhere. Alvin's full node is likewise confined to his own
// /about/alvin-koay page (see alvinPersonNode's comment).
//
// Still omitted on purpose (do not add without confirmation):
//  - featureList / module count: live count unreconciled. Omitted (absent beats wrong).
//
// House style: human-readable strings in sentence case, no em dash, no banned vocab. Engine
// names are kept out of the descriptions so the canonical-five fixed-order rule does not apply.
import { SITE } from '../data/site';
import { orgNode, brandNode, alvinPersonNode } from '../lib/schema';

const appId = `${SITE.url}/#app`;
const siteId = `${SITE.url}/#site`;
const orgId = orgNode['@id'];
// Alvin's full Person node is emitted only on his dedicated entity page (see alvinPersonNode's
// comment in lib/schema); every other page keeps referencing him by @id only.
const isAlvinPage = Astro.url.pathname === '/about/alvin-koay';

const monthly = (price: string) => ({
  '@type': 'UnitPriceSpecification',
  price,
  priceCurrency: 'USD',
  unitCode: 'MON',
  unitText: 'month',
});

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: `${SITE.url}/`,
      name: SITE.name,
      publisher: { '@id': orgId },
    },
    orgNode,
    brandNode,
    {
      '@type': 'SoftwareApplication',
      '@id': appId,
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: `${SITE.url}/`,
      softwareHelp: {
        '@type': 'WebSite',
        '@id': 'https://docs.zicy.com/#website',
        name: 'Zicy Help Centre',
        url: 'https://docs.zicy.com/',
      },
      description:
        'Zicy is an AI visibility platform to measure how AI describes your brand, prove what is working, and improve where you appear.',
      publisher: { '@id': orgId },
      offers: [
        {
          '@type': 'Offer',
          name: 'Starter',
          price: '79',
          priceCurrency: 'USD',
          url: `${SITE.url}/pricing`,
          priceSpecification: monthly('79'),
        },
        {
          '@type': 'Offer',
          name: 'Growth',
          price: '199',
          priceCurrency: 'USD',
          url: `${SITE.url}/pricing`,
          priceSpecification: monthly('199'),
        },
        {
          '@type': 'Offer',
          name: 'Scale',
          price: '449',
          priceCurrency: 'USD',
          url: `${SITE.url}/pricing`,
          priceSpecification: monthly('449'),
        },
        {
          '@type': 'Offer',
          name: 'Enterprise',
          url: `${SITE.url}/contact`,
          availability: 'https://schema.org/InStock',
        },
      ],
    },
    ...(isAlvinPage ? [alvinPersonNode] : []),
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
