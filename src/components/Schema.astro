---
// Single owner for ALL sitewide JSON-LD. Imported once by BaseLayout, so this graph
// renders identically on every page. Page-level nodes (FAQPage, Article, Service, the
// Chrome-extension app, per-page product entity pages) live in their own pages and are
// deliberately NOT defined here.
//
// The canonical Organization node (orgNode, from ../lib/schema) is only spliced into the graph
// on the homepage — every other page's WebPage node references it by @id instead (see
// webPageSchema in ../lib/schema). Emitting the full node on every page would put one node with
// the same @id in every file under dist/, which is the entity fragmentation this guards against.
//
// Still omitted on purpose (do not add without confirmation):
//  - featureList / module count: live count unreconciled. Omitted (absent beats wrong).
//
// House style: human-readable strings in sentence case, no em dash, no banned vocab. Engine
// names are kept out of the descriptions so the canonical-five fixed-order rule does not apply.
import { SITE } from '../data/site';
import { ORG_ID, PERSON_IDS, orgNode, alvinPersonNode } from '../lib/schema';

const orgId = ORG_ID;
const appId = `${SITE.url}/#app`;
const siteId = `${SITE.url}/#site`;
const person = PERSON_IDS;
const isHome = Astro.url.pathname === '/';
// Alvin's full Person node is emitted only on his dedicated entity page (see alvinPersonNode's
// comment in lib/schema); every other page keeps referencing him by @id only.
const isAlvinPage = Astro.url.pathname === '/about/alvin-koay';

const monthly = (price: string) => ({
  '@type': 'UnitPriceSpecification',
  price,
  priceCurrency: 'USD',
  unitCode: 'MON',
  unitText: 'month',
});

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: `${SITE.url}/`,
      name: SITE.name,
      publisher: { '@id': orgId },
    },
    ...(isHome ? [orgNode] : []),
    {
      '@type': 'SoftwareApplication',
      '@id': appId,
      name: SITE.name,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: `${SITE.url}/`,
      softwareHelp: {
        '@type': 'WebSite',
        '@id': 'https://docs.zicy.com/#website',
        name: 'Zicy Help Centre',
        url: 'https://docs.zicy.com/',
      },
      description:
        'Zicy is an AI visibility platform to measure how AI describes your brand, prove what is working, and improve where you appear.',
      publisher: { '@id': orgId },
      offers: [
        {
          '@type': 'Offer',
          name: 'Starter',
          price: '79',
          priceCurrency: 'USD',
          url: `${SITE.url}/pricing`,
          priceSpecification: monthly('79'),
        },
        {
          '@type': 'Offer',
          name: 'Growth',
          price: '199',
          priceCurrency: 'USD',
          url: `${SITE.url}/pricing`,
          priceSpecification: monthly('199'),
        },
        {
          '@type': 'Offer',
          name: 'Scale',
          price: '449',
          priceCurrency: 'USD',
          url: `${SITE.url}/pricing`,
          priceSpecification: monthly('449'),
        },
        {
          '@type': 'Offer',
          name: 'Enterprise',
          url: `${SITE.url}/contact`,
          availability: 'https://schema.org/InStock',
        },
      ],
    },
    ...(isAlvinPage ? [alvinPersonNode] : []),
    {
      '@type': 'Person',
      '@id': person.ritu,
      name: 'Ritu Khanna',
      jobTitle: 'Co-founder',
      description:
        'Over 15 years in the corporate sector leading environmental-industry projects, plus a decade in SEO strategy and content planning. At Zicy, Ritu applies that experience to develop practical AI-first optimisation methods that help businesses become visible in AI-generated answers.',
      worksFor: { '@id': orgId },
    },
    {
      '@type': 'Person',
      '@id': person.peter,
      name: 'Peter Kua',
      jobTitle: 'Chief Data Officer',
      worksFor: { '@id': orgId },
    },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
