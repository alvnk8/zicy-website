---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Bahasa Malaysia translation of src/pages/legal/privacy.astro, required alongside the
// English version under Malaysian law. This translation has NOT been reviewed by a
// Bahasa Malaysia speaker or by counsel — it needs that review pass before it can be
// treated as authoritative. The English version is the controlling text: see the
// prevailing-language notice on both pages. Keep this file's structure (section order,
// ids, table shapes, TOC) in lockstep with privacy.astro whenever that page changes.
const title = 'Dasar privasi, Zicy';
const description =
  'Cara Zicy dan Growth Pro Sdn. Bhd. mengumpul, menggunakan, berkongsi dan melindungi data peribadi merentasi aplikasi web Zicy, sambungan Chrome, perunding AEO/GEO dan pemalam WordPress.';

const sections = [
  { id: 'sec-1-short-version', label: '1. Versi ringkas' },
  { id: 'sec-2-who-this-covers', label: '2. Skop dasar ini' },
  { id: 'sec-3-controller-processor', label: '3. Pengawal dan pemproses data' },
  { id: 'sec-4-what-we-collect', label: '4. Apa yang kami kumpul dan sebabnya' },
  { id: 'sec-5-google-user-data', label: '5. Data pengguna Google' },
  { id: 'sec-6-chrome-extension', label: '6. Sambungan Chrome' },
  { id: 'sec-7-consultant', label: '7. Perunding AEO dan GEO awam' },
  { id: 'sec-8-ai-and-models', label: '8. Cara kami menggunakan AI' },
  { id: 'sec-9-cookies', label: '9. Kuki dan teknologi serupa' },
  { id: 'sec-10-sharing', label: '10. Dengan siapa kami berkongsi data' },
  { id: 'sec-11-transfers', label: '11. Ke mana perginya data anda' },
  { id: 'sec-12-retention', label: '12. Berapa lama kami menyimpan data' },
  { id: 'sec-13-security', label: '13. Cara kami melindunginya' },
  { id: 'sec-14-your-rights', label: '14. Hak anda' },
  { id: 'sec-15-children', label: '15. Kanak-kanak' },
  { id: 'sec-16-changes', label: '16. Perubahan kepada dasar ini' },
  { id: 'sec-17-contact', label: '17. Hubungi kami' },
];
---
<BaseLayout title={title} description={description} lang="ms">
  <link rel="alternate" hreflang="en" href="https://www.zicy.com/legal/privacy" slot="head" />
  <link rel="alternate" hreflang="ms-MY" href="https://www.zicy.com/legal/privacy-bm" slot="head" />
  <link rel="alternate" hreflang="x-default" href="https://www.zicy.com/legal/privacy" slot="head" />
  <section class="hero inner">
    <div class="wrap">
      <span class="eyebrow">Perundangan</span>
      <h1>Dasar privasi</h1>
      <p class="meta-dates">Kemas kini terakhir: 6 Ogos 2026</p>
      <p class="lang-notice">
        Dasar ini diterbitkan dalam Bahasa Inggeris dan Bahasa Malaysia. Sekiranya terdapat percanggahan antara
        versi Bahasa Malaysia ini dengan versi Bahasa Inggeris, versi Bahasa Inggeris akan diguna pakai.
      </p>
      <p class="sub">
        Dasar ini menerangkan apa yang dikumpul oleh Zicy, sebabnya, dengan siapa kami berkongsi data tersebut,
        dan apa yang boleh anda minta kami lakukan mengenainya. Zicy dikendalikan oleh Growth Pro Sdn. Bhd. di
        Penang, Malaysia.
      </p>
      <p class="sibling-links">
        <a href="/legal/cookies">Dasar kuki</a> ·
        <button type="button" class="cc-reopen" onclick="window.zicyOpenCookieSettings && window.zicyOpenCookieSettings()">Tetapan kuki</button> ·
        <a href="/legal/privacy">English</a>
      </p>
    </div>
  </section>

  <section class="legal-body">
    <div class="wrap">
      <article class="prose">
        <nav class="toc" aria-label="Kandungan">
          <h2>Kandungan</h2>
          <ol>
            {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
          </ol>
        </nav>

        <h2 id="sec-1-short-version">1. Versi ringkas</h2>
        <p>Ringkasan mudah difahami. Ini hanyalah ringkasan, dan selebihnya dasar ini yang terpakai.</p>
        <table class="ctable">
          <thead><tr><th>Soalan</th><th>Jawapan</th></tr></thead>
          <tbody>
            <tr>
              <th scope="row">Siapa yang menguruskan Zicy</th>
              <td data-col="Jawapan">Growth Pro Sdn. Bhd., sebuah syarikat berdaftar di Malaysia.</td>
            </tr>
            <tr>
              <th scope="row">Apa yang kami simpan secara utama</th>
              <td data-col="Jawapan">Butiran akaun anda, butiran bil anda, jenama dan prompt yang anda pilih untuk dijejak, dan data yang anda sambungkan daripada Google, Bing dan laman web anda sendiri.</td>
            </tr>
            <tr>
              <th scope="row">Adakah kami menjual data anda</th>
              <td data-col="Jawapan">Tidak. Kami tidak menjual data peribadi dan kami tidak berkongsi data tersebut untuk pengiklanan tingkah laku silang konteks (cross-context behavioural advertising).</td>
            </tr>
            <tr>
              <th scope="row">Berapa lama kami menyimpannya</th>
              <td data-col="Jawapan">Selagi akaun anda aktif, kemudian untuk tempoh yang dinyatakan dalam seksyen 12.</td>
            </tr>
          </tbody>
        </table>

        <h2 id="sec-2-who-this-covers">2. Skop dasar ini</h2>
        <p>Dasar ini terpakai kepada:</p>
        <ul>
          <li>Aplikasi web Zicy di app.zicy.com</li>
          <li>Laman web pemasaran Zicy di zicy.com dan pusat bantuan di docs.zicy.com</li>
          <li>Sambungan Chrome Zicy</li>
          <li>Alat perunding AEO dan GEO awam di zicy.com/consultant</li>
          <li>Pemalam WordPress Zicy</li>
          <li>Perbualan e-mel, sokongan dan jualan dengan kami</li>
        </ul>
        <p>Dasar ini tidak meliputi laman web pihak ketiga yang kami pautkan, atau apa yang dilakukan oleh platform AI dengan soalan yang anda taip terus ke dalamnya.</p>

        <h2 id="sec-3-controller-processor">3. Apabila kami menjadi pengawal data dan apabila kami menjadi pemproses data</h2>
        <p>Perbezaan ini penting jika anda membeli Zicy bagi pihak klien atau majikan anda.</p>
        <p><strong>Kami adalah pengawal data bagi:</strong></p>
        <ul>
          <li>Butiran akaun dan profil anda</li>
          <li>Rekod organisasi, pasukan dan jemputan anda</li>
          <li>Rekod bil, langganan dan kuota</li>
          <li>Data penggunaan produk, peranti dan log</li>
          <li>Komunikasi pemasaran dan sokongan</li>
        </ul>
        <p><strong>Kami adalah pemproses data bagi:</strong></p>
        <ul>
          <li>Profil jenama, prompt yang dijejak dan senarai pesaing yang anda masukkan</li>
          <li>Data Analytics dan Search Console yang anda sambungkan</li>
          <li>Kandungan yang dirayapi daripada laman web yang anda tetapkan</li>
          <li>Respons enjin AI yang direkodkan bagi prompt yang anda jejak</li>
          <li>Draf kandungan yang dijana atau dioptimumkan dalam produk</li>
        </ul>
        <p>
          Bagi kumpulan kedua itu, anda, atau klien yang anda wakili, adalah pengawal data. Terma pemprosesan
          kami bagi data tersebut boleh diperoleh atas permintaan daripada
          <a href="mailto:privacy@zicy.com">privacy@zicy.com</a>.
        </p>

        <h2 id="sec-4-what-we-collect">4. Apa yang kami kumpul dan sebabnya</h2>
        <p>Semua yang berikut sama ada diberikan oleh anda, dijana melalui penggunaan Zicy oleh anda, atau diperoleh daripada perkhidmatan yang anda sambungkan.</p>

        <h3>4.1 Akaun dan identiti</h3>
        <ul>
          <li><strong>Apa:</strong> nama penuh, alamat e-mel, kata laluan (disimpan dalam bentuk hash, tidak pernah dalam bentuk boleh baca), nama organisasi, ID organisasi, kaedah log masuk, peranan, skop akses profil</li>
          <li><strong>Sebab:</strong> untuk mencipta dan melindungi akaun anda, menguatkuasakan kebenaran, dan menyediakan perkhidmatan</li>
          <li><strong>Asas undang-undang, apabila GDPR terpakai:</strong> pelaksanaan kontrak</li>
        </ul>

        <h3>4.2 Pasukan dan jemputan</h3>
        <ul>
          <li><strong>Apa:</strong> alamat e-mel, peranan dan status sesiapa yang anda jemput, dan tarikh luput jemputan mereka</li>
          <li><strong>Sebab:</strong> untuk menguruskan akses pasukan dan peruntukan kuota</li>
          <li><strong>Nota:</strong> jika anda menjemput rakan sekerja, anda meminta kami menghantar e-mel bagi pihak anda. Jemput hanya orang yang menjangkakan e-mel daripada anda</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak, dan kepentingan sah kami dalam mengendalikan ciri pasukan</li>
        </ul>

        <h3>4.3 Bil dan langganan</h3>
        <ul>
          <li><strong>Apa:</strong> pelan, penggunaan kuota dan kredit, pembelian tambahan, penebusan baucar, invois, butiran hubungan bil</li>
          <li><strong>Sebab:</strong> untuk menerima bayaran, mengeluarkan invois, memenuhi kewajipan cukai dan perakaunan</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak, dan kewajipan undang-undang</li>
        </ul>

        <h3>4.4 Data jenama dan prompt</h3>
        <ul>
          <li><strong>Apa:</strong> nama jenama dan variasinya, URL laman web, industri, produk dan perkhidmatan, misi, cadangan jualan unik, nada dan gaya penulisan, nama dan URL pesaing, fakta jenama seperti tahun penubuhan dan lokasi ibu pejabat, prompt yang anda jejak, dan tag yang anda gunakan</li>
          <li><strong>Sebab:</strong> setiap modul Zicy ditentukur berdasarkan data ini. Tanpanya kami tidak dapat mengukur apa-apa</li>
          <li><strong>Amaran data peribadi:</strong> medan ini adalah teks bebas. Jangan masukkan data peribadi tentang individu melainkan perlu, dan jangan sekali-kali masukkan data kategori khas seperti maklumat kesihatan atau biometrik</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak. Jika data tersebut milik klien anda, kami memprosesnya atas arahan anda</li>
        </ul>

        <h3>4.5 Respons enjin AI</h3>
        <ul>
          <li><strong>Apa:</strong> jawapan yang dikembalikan oleh ChatGPT, Gemini, Perplexity, Google AI Overviews dan Google AI Mode bagi prompt yang anda jejak, berserta jenama, kedudukan, sentimen dan petikan yang kami ekstrak daripadanya</li>
          <li><strong>Cara:</strong> kami menghantar prompt yang anda jejak kepada setiap enjin pada kitaran harian dan merekodkan responsnya</li>
          <li><strong>Data peribadi sampingan:</strong> jawapan AI boleh menyebut nama seseorang, contohnya seorang pengasas atau penulis. Kami menyimpan jawapan tersebut seperti yang dikembalikan supaya anda mempunyai bukti</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak, dan kepentingan sah kami dalam menyediakan rekod pengukuran yang boleh anda percayai</li>
        </ul>

        <h3>4.6 Akaun Google yang disambungkan</h3>
        <p>Diliputi secara berasingan dalam seksyen 5, kerana Google mengenakan peraturan khusus ke atas kami.</p>

        <h3>4.7 Bing Webmaster Tools yang disambungkan</h3>
        <ul>
          <li><strong>Apa:</strong> paparan (impressions), klik, kadar klik-tayang, kedudukan purata, halaman teratas dan pertanyaan teratas bagi hartanah yang anda sambungkan</li>
          <li><strong>Sebab:</strong> indeks Bing turut memberi maklumat kepada Microsoft Copilot dan enjin jawapan lain, jadi ia sebahagian daripada gambaran keterlihatan anda</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak</li>
        </ul>

        <h3>4.8 Pemalam WordPress dan log bot AI</h3>
        <ul>
          <li><strong>Apa:</strong> rekod log akses yang menunjukkan perayap AI mana yang melawat laman web anda dan halaman mana yang mereka baca. Bergantung pada konfigurasi pelayan anda, log ini boleh mengandungi alamat IP dan rentetan ejen pengguna (user-agent)</li>
          <li><strong>Sebab:</strong> untuk menunjukkan kepada anda pembantu AI mana yang sebenarnya membaca laman web anda dan dari mana mereka mengambil jawapan</li>
          <li><strong>Tanggungjawab anda:</strong> anda adalah pengawal data bagi log pelayan anda sendiri. Segerakkan log tersebut hanya jika anda berhak berbuat demikian</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak, atas arahan anda</li>
        </ul>

        <h3>4.9 Data rayapan laman web</h3>
        <ul>
          <li><strong>Apa:</strong> URL halaman, tajuk, meta deskripsi, tajuk kecil, kandungan badan, data berstruktur, robots.txt, peta laman dan llms.txt bagi domain yang anda tetapkan</li>
          <li><strong>Sebab:</strong> untuk menjalankan audit laman, ringkasan halaman, pengesanan pendua dan penskoran kandungan</li>
          <li><strong>Had:</strong> kami hanya merayapi domain yang anda tetapkan pada profil jenama, dan kami tidak pernah menerbitkan atau mengubah apa-apa pada laman web anda. Setiap aset yang dihasilkan Zicy diserahkan kepada anda untuk diterbitkan sendiri</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak</li>
        </ul>

        <h3>4.10 Ask Zicy dan perunding AI</h3>
        <ul>
          <li><strong>Apa:</strong> mesej yang anda taip ke dalam Ask Zicy, tajuk tab sembang yang anda tetapkan, dan respons yang dikembalikan</li>
          <li><strong>Sebab:</strong> untuk menjawab soalan anda dan mengukur penggunaan sembang berbanding pelan anda</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak</li>
        </ul>

        <h3>4.11 Kandungan yang dijana dan dioptimumkan</h3>
        <ul>
          <li><strong>Apa:</strong> draf artikel, salinan halaman yang dioptimumkan, penanda skema dan fail llms.txt yang dihasilkan dalam produk, serta input yang anda berikan untuk menghasilkannya</li>
          <li><strong>Sebab:</strong> supaya pustaka kandungan anda kekal tersimpan dan anda boleh kembali kepada draf</li>
          <li><strong>Asas undang-undang:</strong> pelaksanaan kontrak</li>
        </ul>

        <h3>4.12 Data penggunaan produk, peranti dan log</h3>
        <ul>
          <li><strong>Apa:</strong> alamat IP, jenis pelayar dan peranti, halaman dan ciri yang digunakan, cap masa, URL rujukan, rekod ralat dan diagnostik</li>
          <li><strong>Sebab:</strong> untuk mengekalkan keselamatan perkhidmatan, mendiagnosis kerosakan, mencegah penyalahgunaan, dan memahami ciri yang digunakan</li>
          <li><strong>Asas undang-undang:</strong> kepentingan sah dalam mengamankan dan menambah baik perkhidmatan</li>
        </ul>

        <h3>4.13 Komunikasi dan pemasaran</h3>
        <ul>
          <li><strong>Apa:</strong> butiran borang hubungan dan permintaan demo, perbualan sokongan, dan pilihan e-mel</li>
          <li><strong>Sebab:</strong> untuk membalas anda dan menghantar e-mel produk serta pemasaran yang anda minta</li>
          <li><strong>Kawalan:</strong> pusat pemberitahuan dalam Settings mempunyai suis induk untuk menjeda semua e-mel pilihan. E-mel mengenai pembayaran, invois dan jemputan adalah operasi dan sentiasa dihantar</li>
          <li><strong>Asas undang-undang:</strong> persetujuan bagi pemasaran, kepentingan sah bagi mesej operasi</li>
        </ul>

        <h2 id="sec-5-google-user-data">5. Data pengguna Google, dan keperluan Penggunaan Terhad Google</h2>
        <p>
          Jika anda menyambungkan Google Analytics atau Google Search Console, Zicy mengakses data pengguna
          Google melalui API Google, dengan kebenaran jelas anda pada skrin persetujuan.
        </p>
        <p><strong>Apa yang kami akses:</strong></p>
        <ul>
          <li>Google Analytics: metrik trafik, sumber dan penglibatan bagi hartanah yang anda pilih, termasuk sumber rujukan AI yang kami laporkan</li>
          <li>Google Search Console: data pertanyaan, paparan, klik, kadar klik-tayang dan kedudukan bagi hartanah yang anda pilih</li>
          <li>Alamat e-mel akaun Google yang disambungkan, supaya anda dapat melihat akaun mana yang dipautkan dan memutuskan sambungannya</li>
        </ul>
        <p><strong>Cara kami menggunakannya:</strong> hanya untuk menghasilkan laporan dan ciri yang boleh anda lihat dalam Zicy. Tiada yang lain.</p>
        <p>
          <strong>Komitmen Penggunaan Terhad.</strong> Penggunaan dan pemindahan maklumat oleh Zicy yang diterima
          daripada API Google mematuhi
          <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>,
          termasuk keperluan Penggunaan Terhad (Limited Use). Pada dasarnya ini bermaksud:
        </p>
        <ul>
          <li>Kami menggunakan data pengguna Google hanya untuk menyediakan atau menambah baik ciri yang kelihatan dan menonjol dalam Zicy</li>
          <li>Kami tidak memindahkan data pengguna Google kecuali untuk menyediakan ciri tersebut dengan persetujuan anda, bagi tujuan keselamatan, untuk mematuhi undang-undang, atau dalam penggabungan, pengambilalihan atau penjualan aset</li>
          <li>Kami tidak membenarkan manusia membaca data pengguna Google, kecuali apabila anda telah bersetuju secara khusus, apabila perlu bagi keselamatan atau untuk mematuhi undang-undang, atau apabila data tersebut telah diagregatkan bagi operasi dalaman</li>
          <li>Kami tidak menggunakan data pengguna Google untuk pengiklanan, dan kami tidak menjualnya</li>
        </ul>
        <p>
          <strong>Cara memutuskan sambungan:</strong> buka Site Traffic dalam aplikasi dan pilih Disconnect pada
          tab Analytics atau Search Console, atau tarik balik akses Zicy di
          <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>. Menarik balik
          akses menghentikan penyegerakan akan datang. Untuk memadam data yang telah diimport, hubungi
          <a href="mailto:privacy@zicy.com">privacy@zicy.com</a>.
        </p>

        <h2 id="sec-6-chrome-extension">6. Sambungan Chrome</h2>
        <p>Sambungan Chrome Zicy mengaudit sesebuah halaman untuk kesediaan AI apabila anda memintanya.</p>
        <ul>
          <li>Ia menganalisis halaman hanya apabila anda mencetuskan audit. Ia tidak berjalan di latar belakang</li>
          <li>Ia tidak menjejak atau menghantar sejarah pelayaran anda</li>
          <li>Ia tidak menjual atau berkongsi data anda dengan pihak ketiga bagi tujuan mereka sendiri</li>
          <li>Menyahpasang sambungan ini menghentikan semua pengumpulan data</li>
        </ul>

        <h2 id="sec-7-consultant">7. Perunding AEO dan GEO awam</h2>
        <p>Alat perunding di zicy.com/consultant terbuka kepada pelawat tanpa akaun.</p>
        <ul>
          <li>Kami memproses soalan dan URL yang anda hantar bagi tujuan menjawabnya</li>
          <li>Jangan tampal maklumat sulit atau peribadi ke dalam alat awam</li>
        </ul>

        <h2 id="sec-8-ai-and-models">8. Cara kami menggunakan AI, dan sama ada data anda melatih model</h2>
        <p>
          Ini soalan yang paling kerap ditanya oleh pembeli, jadi kami menjawabnya secara terus. Kami menggunakan
          AI dalam dua cara yang berbeza, dan kami memastikan kedua-duanya kekal berasingan, bukan bercampur.
        </p>

        <h3>OpenAI: Ask Zicy, embedding, kandungan dan analisis</h3>
        <p>Ask Zicy, embedding kami, serta alat kandungan dan analisis kami berjalan di atas API OpenAI.</p>
        <ul>
          <li>OpenAI tidak menggunakan data API untuk melatih modelnya melainkan pelanggan bersetuju secara khusus. Zicy tidak bersetuju berbuat demikian</li>
          <li>OpenAI boleh menyimpan input dan output API selama sehingga 30 hari bagi tujuan pemantauan penyalahgunaan, kemudian memadamnya</li>
          <li>OpenAI telah menamatkan audit SOC 2 Type 2 yang meliputi platform API</li>
        </ul>

        <h3>Prompt yang dijejak dan dihantar kepada enjin AI yang kami ukur</h3>
        <p>
          Secara berasingan daripada cara kami menggunakan OpenAI, Zicy menghantar prompt yang anda jejak kepada
          ChatGPT, Gemini, Perplexity, Google AI Overviews dan Google AI Mode, bagi tujuan merekodkan jawapan
          enjin-enjin tersebut. Itulah produk itu sendiri.
        </p>

        <ul>
          <li>Kami menggunakan statistik yang telah diagregatkan dan dinyahkenal pasti, yang tidak dapat mengenal pasti anda atau klien anda, untuk menambah baik penanda aras dan ciri Zicy</li>
          <li>Kami tidak membuat keputusan tentang anda yang mempunyai kesan undang-undang atau kesan ketara yang serupa semata-mata menggunakan pemprosesan automatik</li>
        </ul>

        <h2 id="sec-9-cookies">9. Kuki dan teknologi serupa</h2>
        <p>
          Kami menggunakan kuki dan teknologi serupa untuk log masuk dan keselamatan, untuk mengingati keutamaan
          seperti suis tema, dan untuk mengukur penggunaan laman dan produk.
        </p>
        <p>
          Kuki bukan penting ditetapkan hanya dengan persetujuan anda, dan anda boleh menukar pilihan anda pada
          bila-bila masa menggunakan
          <button type="button" class="cc-reopen inline" onclick="window.zicyOpenCookieSettings && window.zicyOpenCookieSettings()">Tetapan kuki</button>
          di bahagian bawah laman. Senarai penuh terdapat dalam <a href="/legal/cookies">dasar kuki</a>.
        </p>

        <h2 id="sec-10-sharing">10. Dengan siapa kami berkongsi data</h2>
        <p>Kami berkongsi data peribadi hanya dengan kategori di bawah, dan hanya sekadar yang diperlukan.</p>
        <ul>
          <li><strong>Pembekal perkhidmatan, kadangkala digelar sub-pemproses.</strong> Hosting, pangkalan data, penghantaran e-mel, pembayaran, pemantauan ralat, analitik produk dan pembekal AI. Setiap satu terikat dengan syarat penerbitannya sendiri, dan apabila terdapat perjanjian pemprosesan data, perjanjian itu memerlukan pembekal tersebut melindungi data dan memprosesnya hanya atas arahan kami</li>
          <li><strong>Enjin AI yang kami ukur.</strong> Kami menghantar teks prompt yang anda jejak</li>
          <li><strong>Organisasi anda sendiri.</strong> Sesiapa yang anda jemput boleh melihat profil yang ditugaskan kepada mereka. Pemilik boleh melihat penggunaan dan pembilan organisasi</li>
