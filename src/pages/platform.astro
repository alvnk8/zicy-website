---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
// No-chrome product exports — topbar + content only, no left module-nav rail or in-frame
// Zicy logo. Demo brand "Acme Pickleball Fashion" is illustrative, not a real client.
import promptManager from '../assets/screenshots/platform-prompt-manager.png';
import aiVisibility from '../assets/screenshots/platform-ai-visibility.png';
import brandIntelligenceReport from '../assets/screenshots/platform-brand-intelligence.png';
import citationOverview from '../assets/screenshots/platform-citation-analysis.png';
import takeAction from '../assets/screenshots/platform-take-action.png';
import siteTraffic from '../assets/screenshots/platform-site-traffic.png';
// Hero screenshot — the prioritised fix backlog (diagnose to act) for demo brand "Cobalt".
import heroActionPlan from '../assets/screenshots/platform-hero-action-plan.png';
import { SITE } from '../data/site';
import { webPageSchema } from '../lib/schema';

const title = 'Zicy Platform, every module across one loop: measure, diagnose, act, prove';
const description =
  'Zicy is the truth layer for AI visibility, with modules across one loop (measure, diagnose, act, prove) that show what AI says about your brand, why, how to fix it, and whether it moved demand. Every engine, every language; built to current AEO/GEO best practice. For small and mid-sized businesses, no AEO specialist required.';

// Module set — single source of truth. Drives the rendered module set AND the ItemList schema.
const moduleGroups = [
  {
    stage: 'Measure',
    modules: [
      { name: 'Prompt Manager', desc: 'Choose and own the exact questions AI is judged on; build and tag a prompt set across segments, topics and languages, run across all five engines.' },
      { name: 'AI Visibility', desc: 'The core scoreboard: brand mention coverage, citation rate, AI share of voice and average ranking, per engine, over time, plus a sentiment score out of 100.' },
      { name: 'Competitive AI Performance', desc: 'Your standing against named competitors, side by side, on coverage, ranking, citations, share of voice and sentiment.' },
    ],
  },
  {
    stage: 'Diagnose',
    modules: [
      { name: 'Brand Intelligence', desc: 'How ChatGPT, Gemini, Google AI Overviews and Google AI Mode describe you, fact-checked: the AI Reality Score, the gaps you confirm, and a prioritised action plan. Perplexity is covered by prompt tracking.' },
      { name: 'Competitor Sentiment Profiles', desc: 'How AI frames each rival, with a sentiment score out of 100 and the words it uses most.' },
      { name: 'Key Topics Analysis', desc: 'Where you lead the answer, where you are in a fight, and where you are invisible, by topic.' },
      { name: 'Citation Analysis', desc: 'Which sources AI cites about you, owned vs. earned vs. competitor vs. uncited, with narrative control and competitor share, down to the URL.' },
      { name: 'Site Audit', desc: 'Technical AI-readiness: llms.txt, AI-bot access, schema and page health.' },
      { name: 'Entity Audit', desc: 'Reads your own site the way an AI engine does and reports what stops it seeing one clear company. Findings are ranked Blocking, High or Medium, and each fix is markup you publish.' },
      { name: 'Internal Linking', desc: 'The links to add between your own pages, inside the page copy, read from your latest Entity Audit. Pages that nothing links to are marked, because AI tends to read them on their own.' },
      { name: 'GBP Audit', desc: 'Nine checks on your connected Google Business Profile and the website it links to, compared with up to four competitors you track. Each finding comes with a fix you make yourself, in Google or on your website.' },
      { name: 'Visibility Gaps', desc: 'The prioritised list of what to fix and what to publish, ranked by impact.' },
    ],
  },
  {
    stage: 'Act',
    modules: [
      { name: 'GBP Optimizer', desc: 'A new business description, within Google\'s 750-character limit, and a category suggestion, written from your GBP Audit findings. You paste them into Google.' },
      { name: 'Content Studio', desc: 'One library for everything Content Generator writes and Content Optimizer scores.' },
      { name: 'Content Generator', desc: 'Turns a topic into a finished article, as one instant draft or step by step with your approval at each stage.' },
      { name: 'Content Optimizer', desc: 'Scores a page you already have and rewrites the sections that will lift the score. Every rewrite waits for your review.' },
      { name: 'Schema Generator', desc: 'Reads one page, works out what structured data is missing, and writes the JSON-LD to add.' },
      { name: 'LLMs Generator', desc: 'Builds your llms.txt, a plain-text summary of your business and key pages for AI systems to read.' },
      { name: 'Pages Summary', desc: 'Every page on record for your site, with tools to find overlapping pages and pages worth linking to.' },
    ],
  },
  {
    stage: 'Prove',
    modules: [
      { name: 'Site Traffic', desc: 'AI-referred sessions and downstream engagement from GA4 and Search Console, connected to the visibility work: the line from AI visibility to demand.' },
      { name: 'Impact Tracker', desc: 'Put each change you ship on the same timeline as your AI visibility metrics. A table compares the week before each change with the latest week, and labels the result as change that coincided, not proven cause.' },
    ],
  },
];
const allModules = moduleGroups.flatMap((g) => g.modules);

// Module-reference doc slug per module (docs.zicy.com). Kept separate from the module data so the
// ItemList schema, built from allModules, is unchanged. A module with no entry renders no link.
const MODULE_DOC: Record<string, string> = {
  'Prompt Manager': 'm-02-prompt-manager',
  'AI Visibility': 'm-04-ai-visibility-dashboard',
  'Competitive AI Performance': 'm-05-competitive-ai-performance',
  'Brand Intelligence': 'm-06-brand-intelligence',
  'Competitor Sentiment Profiles': 'm-08-competitor-sentiment-profiles',
  'Key Topics Analysis': 'm-09-key-topics-analysis',
  'Citation Analysis': 'm-10-citation-analysis',
  'Site Audit': 'm-11-site-audit',
  'Visibility Gaps': 'm-12-visibility-gaps',
  'Entity Audit': 'm-18-entity-audit',
  'Internal Linking': 'm-28-internal-linking',
  'GBP Audit': 'm-20-gbp-audit',
  'GBP Optimizer': 'm-21-gbp-optimizer',
  'Content Studio': 'm-22-content-studio',
  'Content Generator': 'm-23-content-generator',
  'Content Optimizer': 'm-24-content-optimizer',
  'Schema Generator': 'm-25-schema-generator',
  'LLMs Generator': 'm-26-llms-generator',
  'Pages Summary': 'm-27-pages-summary',
  'Impact Tracker': 'm-19-impact-tracker',
  'Site Traffic': 'm-14-site-traffic',
};

// Page-level structured data. The Zicy Organization, WebSite and SoftwareApplication entities
// are sitewide (src/components/Schema.astro). This page keeps its module ItemList plus a WebPage
// node that carries the speakable hint and points at the canonical app entity.
const platformPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}/platform`,
  url: `${SITE.url}/platform`,
  about: { '@id': `${SITE.url}/#app` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#at-a-glance'] },
};

const moduleList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Zicy platform modules',
  numberOfItems: allModules.length,
  itemListElement: allModules.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.name,
    description: m.desc,
  })),
};

const faqs = [
  {
    q: 'How many AI engines does Zicy track?',
    a: 'Zicy tracks five engines, ChatGPT, Gemini, Perplexity, Google AI Overviews and Google AI Mode, on every plan. Every tracked prompt runs across each engine.',
  },
  {
    q: 'What is the difference between the loop and the modules?',
    a: 'The loop (measure, diagnose, act, prove) is the workflow; the modules are the tools that deliver each stage. You move around one loop using the modules below.',
  },
  {
    q: 'Does Zicy change my site, or only report on it?',
    a: 'It reports and gives you the fixes, but you publish them. The Take Action tools write schema, llms.txt, content and Google Business Profile suggestions, and Entity Audit and Internal Linking tell you which markup and links to add. Nothing changes on your site or your listing until you publish it.',
  },
  {
    q: 'How often does Zicy update?',
    a: 'Zicy tracks daily on every tier. Answer engines evolve gradually rather than by the hour, but daily tracking means you see meaningful shifts as soon as they happen, not a week after.',
  },
  {
    q: 'Can agencies white-label the platform?',
    a: 'Yes, through a custom agency arrangement, usually alongside an Enterprise or Scale plan. Our team sets up your logo, app name, accent colour and own domain on the dashboard. Agencies can also run many client profiles from one login. See the agencies solution page.',
  },
];
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Loop lead modules (four cards).
const loop = [
  { k: '01 · Measure', name: 'AI Visibility', desc: 'The core scoreboard, brand mention coverage, citation rate, AI share of voice and average ranking, per engine, over time.' },
  { k: '02 · Diagnose', name: 'Brand Intelligence', desc: 'Perception, the AI Reality Score (fact-check / hallucination), the entity graph, and a prioritised action plan.' },
  { k: '03 · Act', name: 'Take Action tools', desc: 'GBP Optimizer, content, schema and llms.txt tools. Every output is something you publish; nothing goes live without you.' },
  { k: '04 · Prove', name: 'Impact Tracker', desc: 'Each change you ship, dated, on the same chart as your AI visibility, with Site Traffic connecting it to demand.' },
];

// The four primary KPIs (NEW "four numbers" section).
const numbers = [
  { name: 'Brand Mention Coverage', desc: 'How often your brand is named in the answer.' },
  { name: 'Citation Rate', desc: 'How often your brand is explicitly cited or linked.' },
  { name: 'AI Share of Voice', desc: 'Your share of category mentions versus tracked rivals.' },
  { name: 'Average AI Ranking', desc: 'Where you appear within the answer.' },
];

const differentiators = [
  { h: 'Truth, not just mentions.', p: 'The AI Reality Score catches hallucinations and outdated facts before buyers see them.' },
  { h: 'Every market, every language.', p: 'Coverage across the five engines in the languages your customers actually use, wherever they are. Built on Penang-rooted regional strength.' },
  { h: 'Act inside the tool.', p: 'Remediation and content tooling built to current best practice, no hand-off gap.' },
  { h: 'Change to consequence.', p: 'Impact Tracker shows what moved after each change you shipped, dated, and says plainly that it is change that coincided, not proven cause.' },
];

const proofBullets = [
  'AI-referred sessions, tied back to the visibility work.',
  'Answer-intent queries and branded-search behaviour, from GA4 and Search Console.',
  'The link between winning the answer and movement in demand, defensible in a budget review.',
];

const roleCards = [
  { eyebrow: 'For small and mid-sized businesses', p: 'See what AI tells your customers, and fix it, without a specialist.', href: '/solutions/smb', link: 'For small businesses →' },
  { eyebrow: 'For brands', p: 'See whether AI gets your brand right, and fix what is wrong.', href: '/solutions/brands', link: 'For brands →' },
  { eyebrow: 'For PR & communications', p: 'Prove earned media moved the answer, not just the clip count.', href: '/solutions/pr', link: 'For PR →' },
  { eyebrow: 'For marketing & creative agencies', p: 'Run AI visibility as a white-label service line.', href: '/solutions/agencies', link: 'For agencies →' },
  { eyebrow: 'For publishers', p: 'See whether AI attributes your work, or strips the credit.', href: '/solutions/publishers', link: 'For publishers →' },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.zicy.com/' },
    { '@type': 'ListItem', position: 2, name: 'Platform', item: 'https://www.zicy.com/platform' },
  ],
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webPageSchema('/platform', title))} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumb)} />
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(platformPage)} />
    <script type="application/ld+json" set:html={JSON.stringify(moduleList)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
  </Fragment>

  <!-- 1. Hero -->
  <section class="hero inner">
    <div class="wrap">
      <span class="eyebrow">Platform</span>
      <h1>The truth layer for AI visibility.</h1>
      <p class="lead">
        One platform across the whole loop, measure what AI says about your brand, diagnose
        why, act to fix it, and prove it moved demand. Five engines, built to
        current AEO/GEO best practice and aligned with Google&rsquo;s latest spam policies.
        Plain English throughout. No specialist required.
      </p>
      <div class="cta-row">
        <a class="btn btn-p btn-lg" href="https://app.zicy.com/register">Try for free</a>
        <a class="btn btn-o btn-lg" href="/pricing">See pricing</a>
      </div>
      <div style="max-width:1080px;margin:44px auto 0">
        <Screenshot
          src={heroActionPlan}
          alt="Zicy Brand Intelligence action plan showing a prioritised list of reality fixes with impact estimates and escalation status."
          caption="Illustrative product view with sample data."
          priority="eager"
        />
      </div>
    </div>
  </section>

  <!-- At a glance — semantic summary directly below the hero, above the first body section.
       Reuses .shead (heading) and .checklist (list); body text is full-strength --ink (AA on
       paper) and the list marker uses --ok, never the Sky token. No numerals in the copy. -->
  <section id="at-a-glance">
    <div class="wrap">
      <div class="shead">
        <h2>At a glance</h2>
      </div>
      <ul class="checklist">
        <li>Zicy is an AI-visibility platform that tracks how AI answer engines mention, cite, and recommend your brand across ChatGPT, Gemini, Perplexity, Google AI Overviews, and Google AI Mode.</li>
        <li>It runs one loop: measure your AI visibility, diagnose where you are losing the answer, act on the gaps, and prove the impact.</li>
        <li>Core metrics include brand mention coverage, citation rate, AI share of voice, and average AI ranking, with the source behind every citation.</li>
        <li>You can see how you stand against named rivals and where the highest-value topics and queries are still open.</li>
        <li>Setup is pasting your website URL; Zicy writes the questions to track.</li>
      </ul>
    </div>
  </section>

  <!-- 2. 01 · The closed loop (#loop anchor) — four lead-module cards + four screenshots -->
  <section id="loop">
    <div class="wrap">
      <div class="shead">
        <span class="eyebrow"><span class="ix">01</span> The closed loop</span>
        <h2>One loop: measure, diagnose, act, prove.</h2>
        <p>The lead module at each stage, the full set is below.</p>
      </div>
      <div class="loop">
        {loop.map((s) => (
          <div class="step"><div class="k">{s.k}</div><h3>{s.name}</h3><p>{s.desc}</p></div>
        ))}
      </div>
      <!-- Prompt Manager — the entry point to Measure: you choose the questions AI is judged on,
           before any number is read. Full-width above the four stage views. -->
      <div style="margin-top:36px">
        <Screenshot
          src={promptManager}
          alt="Zicy Prompt Manager showing a tagged set of category questions, generated and custom prompts across topics, tagged by theme, built to run across all five engines."
          caption="Prompt Manager: choose and tag the questions AI is judged on, run across all five engines."
        />
      </div>
      <div class="grid-2" style="margin-top:20px">
        <Screenshot
          src={aiVisibility}
          alt="Zicy AI Visibility dashboard with brand mention coverage, citation rate, AI share of voice and average ranking, plus a multi-week performance trend across the five engines."
          caption="AI Visibility: coverage, share of voice, ranking, radar across every engine."
        />
        <Screenshot
          src={brandIntelligenceReport}
          alt="Zicy Brand Intelligence report showing how AI perceives the brand, an AI Reality Score fact-check, and the entity graph."
          caption="Brand Intelligence: perception, AI Reality Score, and the entity graph."
        />
        <Screenshot
          src={citationOverview}
          alt="Zicy Citation Analysis showing which sources AI cites about your brand, owned, earned, competitor and uncited, with narrative control and competitor share, down to the URL."
          caption="Citation Analysis: narrative control, competitor share, and uncited rate."
        />
        <Screenshot
          src={takeAction}
          alt="Zicy Content Studio in the Take Action section, listing optimised and generated content with Content Optimizer and New Content actions."
          caption="Take Action: Content Studio, optimiser and generators."
        />
      </div>
    </div>
  </section>

  <!-- 3. 02 · The four numbers (NEW) — primary KPIs -->
  <section style="background:var(--mist)">
    <div class="wrap">
      <div class="shead">
        <span class="eyebrow"><span class="ix">02</span> The four numbers</span>
        <h2>Four numbers, every engine, every day.</h2>
        <p>Tracked continuously, reported board-ready.</p>
      </div>
      <div class="grid4">
        {numbers.map((n) => (
          <div class="card">
            <h3>{n.name}</h3>
            <p>{n.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 03 · The module set, grouped by loop stage -->
  <section id="modules">
    <div class="wrap">
      <div class="shead">
        <span class="eyebrow"><span class="ix">03</span> The module set</span>
        <h2>Every module, grouped by loop stage.</h2>
        <p>The whole platform, organised the way the work actually runs.</p>
      </div>
      <div class="grid-2">
        {moduleGroups.map((g) => (
          <div class="card">
            <span class="eyebrow">{g.stage}</span>
            <ul class="modlist" style="margin-top:12px">
              {g.modules.map((m) => (
                <li><b>{m.name}</b>{m.desc}{MODULE_DOC[m.name] && (
                  <> <a href={`https://docs.zicy.com/module-reference/${MODULE_DOC[m.name]}/`}>Read the module guide &rarr;</a></>
                )}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="sub" style="margin-top:20px">
        In Diagnose, Brand Intelligence surfaces the AI Reality Score.
        <a href="/platform/ai-reality-score">See how the AI Reality Score is calculated &rarr;</a>
        Two modules have their own pages:
        <a href="/platform/entity-audit">Entity Audit and Internal Linking &rarr;</a>
        <a href="/platform/impact-tracker">Impact Tracker &rarr;</a>
      </p>
    </div>
  </section>

  <!-- 5. 04 · The proof layer (NEW) — capability copy + bullets + Site Traffic screenshot -->
  <section style="background:var(--mist)">
    <div class="wrap">
      <!-- Two-column split: header + intro + bullets in the left column, screenshot in the
           right, both top-aligned (.feature-split is align-items:start) so the image rises to
           the top of the section header rather than sitting below a full-width header. -->
      <div class="feature-split">
        <div>
          <div class="shead" style="margin-bottom:28px">
            <span class="eyebrow"><span class="ix">04</span> The proof layer</span>
            <h2>Proof it brought customers, not just mentions.</h2>
            <p>
              Does winning the AI answer move demand? Zicy connects AI-referred sessions,
              answer-intent queries and branded-search behaviour from GA4 and Search Console to the
              visibility work, so AI visibility stops being a vanity metric. The result is a line
              that&rsquo;s defensible in a budget review.
            </p>
          </div>
          <ul class="checklist">
            {proofBullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <Screenshot
          src={siteTraffic}
          alt="Zicy Site Traffic, Search Console view, answer-intent queries, question impressions and clicks, and branded-search performance (impressions, clicks, average CTR and average position) connected to the AI visibility work."
          caption="Site Traffic: answer-intent queries and branded-search behaviour, connected to the visibility work."
        />
      </div>
    </div>
  </section>

  <!-- 6. 05 · The differentiator — three cards + closing line + CTA -->
  <section>
    <div class="wrap">
      <div class="shead">
        <span class="eyebrow"><span class="ix">05</span> The differentiator</span>
        <h2>Competitors measure. Zicy proves.</h2>
        <p>The truth layer isn&rsquo;t another metric. It&rsquo;s the fact-check. Zicy flags where AI is wrong about you, not just whether you&rsquo;re mentioned.</p>
      </div>
      <div class="grid-3">
        {differentiators.map((d) => (
          <div class="card"><h3>{d.h}</h3><p>{d.p}</p></div>
        ))}
      </div>
      <p class="sub" style="max-width:62ch;margin:32px auto 0;text-align:center">
        We win AI answers the same way we help you win them, by being genuinely easier to
        find, verify and trust.
      </p>
      <div style="text-align:center;margin-top:28px"><a class="btn btn-p btn-lg" href="https://app.zicy.com/register">Try for free</a></div>
    </div>
  </section>

  <!-- 7. 06 · Built for your role (NEW, light) — four solution links -->
  <section style="background:var(--mist)">
    <div class="wrap">
      <div class="shead">
        <span class="eyebrow"><span class="ix">06</span> Built for your role</span>
        <h2>Built for the people who own the answer.</h2>
      </div>
      <div class="grid4">
        {roleCards.map((c) => (
          <a class="card" href={c.href}>
            <span class="k">{c.eyebrow}</span>
            <p>{c.p}</p>
            <span class="arrow">{c.link}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FAQ — native <details> accordion; answers in static HTML + FAQPage schema -->
  <section>
    <div class="wrap">
      <div class="shead">
        <span class="eyebrow">FAQ</span>
        <h2>Platform questions.</h2>
      </div>
      <FaqAccordion items={faqs} defaultOpen={0} />
    </div>
  </section>

  <!-- 9. Final CTA -->
  <section class="final">
    <div class="wrap">
      <h2>See your brand the way AI describes it.</h2>
      <p>All five engines, no commitment. Start a 7-day free trial.</p>
      <div class="hcta">
        <a class="btn btn-p" href="https://app.zicy.com/register">Try for free</a>
        <a class="btn btn-o" href="/pricing">See pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>
