---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { orgNode } from '../lib/schema';
import { LOGO_SCALE } from '../data/press-logo-scale.mjs';

const title = 'Zicy in the press | Media coverage and press kit';
const description =
  'Independent press coverage of Zicy and founder Alvin Koay, plus a downloadable media kit: logo pack, brand colours, headshot and boilerplate.';

const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
// Single date renderer so every date on the page reads identically: "12 July 2026".
function formatDate(iso: string | null) {
  if (!iso) return 'Date not stated';
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${MONTHS[m - 1]} ${y}`;
}

// DNA sentence reproduced exactly as recorded in the verified media-source evidence. Never reword.
const dnaQuote =
  "To address this very gap in the market, GrowthPro built Zicy, an AI-powered platform that tracks share of voice, citation volume, positioning and sentiment across five major answer engines, and uses an AI agent to identify content gaps and restructure website content for LLM retrieval.";

// All seven verified press items, one array. publication/date/headline/summary/href values are
// moved verbatim from the prior coverage + founderMedia arrays; only the structure changed.
// logo paths are the intended /press/<slug>.svg location; none of these files exist in public/
// yet (verified before writing this), so the render below falls back to a text wordmark for
// every one of them rather than emitting a broken <img>.
const coverage = [
  {
    publication: 'Digital News Asia',
    date: '2026-07-12',
    headline: "GrowthPro's Alvin Koay: Google's AI has rewritten the rules of search",
    summary:
      "Alvin explains how Google's AI Overviews and AI Mode have cut into publisher and brand traffic, and introduces Zicy as the platform GrowthPro built to track share of voice, citation volume, positioning and sentiment across the major answer engines.",
    href: 'https://www.digitalnewsasia.com/business/growthpros-alvin-koay-googles-ai-has-rewritten-rules-search',
    type: 'Article',
    scope: 'zicy',
    logo: '/press/digital-news-asia.svg',
    thumb: null,
  },
  {
    publication: 'Biz.bio',
    date: '2026-03-18',
    headline: 'Alvin Koay and Zicy: Rebuilding in the Age of AI',
    summary:
      "A founder profile tracing Alvin's path from an early ad-tech startup through Growth.pro to building Zicy, the system he built to help brands become visible inside AI-generated answers.",
    href: 'https://biz.bio/founders/alvin-koay-and-zicy-rebuilding-in-the-age-of-ai/',
    type: 'Article',
    scope: 'zicy',
    logo: '/press/biz-bio.svg',
    thumb: null,
  },
  {
    publication: 'e27',
    date: '2026-03-16',
    headline: 'The new growth metric: AI Share of Voice',
    summary:
      'Alvin argues that AI Share of Voice and citation authority are becoming the metrics that matter more than traffic, as AI answers replace clicks.',
    href: 'https://e27.co/the-new-growth-metric-ai-share-of-voice-20260316/',
    type: 'Article',
    scope: 'zicy',
    logo: '/press/e27.svg',
    thumb: null,
  },
  {
    publication: 'e27',
    date: '2026-03-12',
    headline: 'Your biggest competitor might be the AI answer itself',
    summary:
      'Alvin explains why AI answer engine optimisation is becoming a strategic necessity for startups, and how being cited by AI is starting to decide who gets considered at all.',
    href: 'https://e27.co/your-biggest-competitor-might-be-the-ai-answer-itself-20260312/',
    type: 'Article',
    scope: 'zicy',
    logo: '/press/e27.svg',
    thumb: null,
  },
  {
    publication: 'Malaysia SME+',
    date: null,
    headline:
      "Answer Engines such as CHATGPT, GEMINI, GOOGLE's AI Mode are your customers' new best friends – businesses must align web pages and online presence or risk losing leads and revenue generation channels.",
    summary:
      'Alvin walks through why answer engine optimisation is replacing traditional SEO, and what businesses need to restructure in their content and schema to stay discoverable.',
    href: 'https://www.malaysiasme.com.my/answer-engines-such-as-chatgpt-gemini-googles-ai-mode-are-your-customers-new-best-friends-businesses-must-align-web-pages-and-online-presence-or-risk-losing-leads-and-revenue-generatio/',
    type: 'Article',
    scope: 'zicy',
    logo: '/press/malaysia-sme.svg',
    thumb: null,
  },
  {
    publication: 'BFM 89.9',
    programme: 'Open For Business',
    date: '2026-03-03',
    headline: 'The Growthpro Strategy to Combat Traditional SEOs',
    summary:
      'Alvin discusses how Growth.pro sells visibility inside AI systems rather than rankings and traffic, and how the agency runs and differentiates itself in a crowded market.',
    href: 'https://www.bfm.my/content/podcast/the-growthpro-strategy-to-combat-traditional-seos',
    type: 'Podcast',
    scope: 'founder',
    logo: '/press/bfm.svg',
    thumb: null,
  },
  {
    publication: 'BFM 89.9',
    programme: 'Marketing Mojo',
    date: '2026-02-10',
    headline: 'Is SEO Dead? The AI Search Shake-Up',
    summary:
      'Alvin discusses how AI tools are changing search behaviour and why traditional SEO metrics are losing relevance for Malaysian marketing teams.',
    href: 'https://www.bfm.my/content/podcast/is-seo-dead-the-ai-search-shake-up',
    type: 'Podcast',
    scope: 'founder',
    logo: '/press/bfm.svg',
    thumb: null,
  },
];

// Effective thumbnail per item: the per-item `thumb` override when set, else the generated tile
// at public/press/tiles/<slug>.webp when that file exists at build time, else null (renders the
// current text-only card — never a broken image, never an empty box). Slug is derived from the
// item's own `logo` path so the two stay in lockstep without a second manual mapping.
function slugFromLogo(logoPath: string) {
  return logoPath.match(/\/press\/([^/.]+)\.svg$/)![1];
}
const PUBLIC_PRESS_DIR = path.resolve(process.cwd(), 'public', 'press');
const TILES_DIR = path.join(PUBLIC_PRESS_DIR, 'tiles');
function effectiveThumb(item: (typeof coverage)[number]) {
  if (item.thumb) return item.thumb;
  const slug = slugFromLogo(item.logo);
  const tileFile = path.join(TILES_DIR, `${slug}.webp`);
  return fs.existsSync(tileFile) ? `/press/tiles/${slug}.webp` : null;
}

// Logo wall image branch: render the publisher's real logo (public/press/<slug>.{svg,png,webp})
// when it exists at build time, greyscale at rest via the existing .logo-wall-item CSS, full
// colour on hover/focus. Falls back to the current text wordmark — never a broken <img> — for any
// publisher without a file. Same LOGO_SCALE table as the tile generator so the two stay in sync.
const WALL_LOGO_EXTENSIONS = ['.svg', '.png', '.webp'];
function publisherLogoSrc(slug: string) {
  for (const ext of WALL_LOGO_EXTENSIONS) {
    if (fs.existsSync(path.join(PUBLIC_PRESS_DIR, `${slug}${ext}`))) return `/press/${slug}${ext}`;
  }
  return null;
}
const WALL_LOGO_BASE_HEIGHT = 34;

// This repo does use astro:assets' <Image> elsewhere (about.astro, PostFigure.astro), but it
// isn't usable here: <Image> requires a static import resolvable at build time from src/, and
// these files are conditionally generated (by scripts/make-press-tiles.mjs, possibly after this
// page's own code hasn't changed) into public/, checked for existence at render time. A plain
// <img> with explicit width/height (matching the tiles' real 800x600) is the correct tool for a
// build-time-conditional public/ asset — hence the fs.existsSync check above instead.

// All coverage, newest first, any undated item last. ISO date strings sort lexicographically in
// chronological order, so a plain string comparison is enough.
const sortedCoverage = [...coverage].sort((a, b) => {
  if (a.date === null && b.date === null) return 0;
  if (a.date === null) return 1;
  if (b.date === null) return -1;
  return b.date.localeCompare(a.date);
});

// The Malaysia SME+ headline as published is ~40 words and partly capitalised. Rendered display
// copy is sentence case and short; the full original is kept as the link's title attribute so
// nothing is lost, keyed by href so a mismatch can never silently apply to the wrong item.
const DISPLAY_HEADLINES: Record<string, string> = {
  'https://www.malaysiasme.com.my/answer-engines-such-as-chatgpt-gemini-googles-ai-mode-are-your-customers-new-best-friends-businesses-must-align-web-pages-and-online-presence-or-risk-losing-leads-and-revenue-generatio/':
    "Answer engines are your customers' new best friends",
};

// JSON-LD is generated from `coverage` (via sortedCoverage, already newest-first with any
// undated item last) so it can never drift from the visible list. headline uses each item's
// full original text, not the shortened on-page display override, since structured data should
// carry the real published headline. datePublished is omitted entirely for the one undated item
// (Malaysia SME+) rather than emitting an empty string.
function toNewsOrPodcastNode(item: (typeof coverage)[number]) {
  return {
    '@type': item.type === 'Podcast' ? 'PodcastEpisode' : 'NewsArticle',
    headline: item.headline,
    url: item.href,
    ...(item.date ? { datePublished: item.date } : {}),
    publisher: { '@type': 'Organization', name: item.publication },
  };
}

const mediaPageUrl = `${SITE.url}/media`;

// about: the site's single canonical Organization node (src/lib/schema.ts), referenced whole
// rather than hand-typed, so name/url/logo/founder/sameAs can never drift from every other page's
// copy of the same entity.
const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${mediaPageUrl}#webpage`,
  name: 'Zicy in the press',
  url: mediaPageUrl,
  about: orgNode,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: sortedCoverage.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: toNewsOrPodcastNode(item),
    })),
  },
};

const uniquePublishers = [...new Set(coverage.map((c) => c.publication))];
const proofLine = `${coverage.length} mentions across ${uniquePublishers.length} publications since February 2026`;

// Publisher logo wall, one entry per unique publication. All five now have a real logo file
// under public/press/ (see publisherLogoSrc above), so the wall renders images.
const publisherWall = uniquePublishers.map((name) => coverage.find((c) => c.publication === name)!);

const dnaItem = coverage.find((c) => c.publication === 'Digital News Asia')!;
const featuredThumb = effectiveThumb(dnaItem);

const inBrief = [
  'Zicy is an AI visibility platform that tracks how brands appear inside AI-generated answers across ChatGPT, Gemini, Perplexity, Google AI Overviews, and Google AI Mode.',
  'Coverage focuses on the shift from rankings to citations, and why being named in an AI answer increasingly decides whether a brand is considered at all.',
  'Founder Alvin Koay speaks on answer engine optimisation, AI share of voice, and what marketing teams should measure as clicks decline.',
  'Zicy was built by Growth.pro and is used by brands, PR agencies, marketing and creative agencies, and publishers.',
];

// Media kit rows. Every href below was checked directly against the filesystem before writing
// this (see build report); each of these four files genuinely exists under public/.
const logoPack = [
  { label: 'Logo, SVG (light)', href: '/zicy-logo.svg' },
  { label: 'Logo, PNG (light)', href: '/zicy-logo.png' },
  { label: 'Logo, SVG (dark)', href: '/zicy-logo-white.svg' },
  { label: 'Logo, PNG (dark)', href: '/zicy-logo-white.png' },
];

// Brand colours: the three facet hues already defined as the brand palette in
// src/styles/theme.css (--sky/--violet/--magenta, commented there as "brand — from logo
// facets"). No new colour values were introduced.
const brandColours = [
  { name: 'Sky', hex: '#83C9EB' },
  { name: 'Violet', hex: '#6E63AC' },
  { name: 'Magenta', hex: '#AA5EA4' },
];

const headshotHref = '/alvin.png';

// Product screenshots: no such asset exists under public/ (checked directly: no file with
// "screenshot" in its name anywhere under public/, only inside src/assets/, which the build
// pipeline processes and does not expose as a stable public/ URL). Row renders muted per the
// hard rule: never link to a file that is not there.
const screenshotsExist = false;

// Free-trial CTA reused verbatim from the site's own persistent header nav (Header.astro) and
// the homepage's own closing CTA (index.astro) — the one label/URL pair used consistently
// site-wide, not written fresh for this page.
const freeTrialLabel = 'Try for free';
const freeTrialHref = 'https://app.zicy.com/register';
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionPageSchema)} />

  <!-- Hero -->
  <section class="hero inner">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">&rsaquo;</span>
        <span class="here" aria-current="page">Media</span>
      </nav>
      <span class="eyebrow">Media</span>
      <h1>Zicy in the press</h1>
      <p class="dek">
        Independent coverage of Zicy, and of founder Alvin Koay, on AI search, answer engines, and
        the shift from rankings to citations.
      </p>
      <p class="proof-line">{proofLine}</p>
      <div class="hero-links">
        <a href="#media-kit">Media kit</a>
        <a href="/contact">Press enquiries</a>
      </div>
    </div>
  </section>

  <!-- Publisher logo wall -->
  <section class="logo-wall-section">
    <div class="wrap">
      <div class="logo-wall">
        {publisherWall.map((p) => {
          const slug = slugFromLogo(p.logo);
          const logoSrc = publisherLogoSrc(slug);
          const scale = LOGO_SCALE[slug] ?? 1;
          return logoSrc ? (
            <img
              class="logo-wall-item logo-wall-img"
              src={logoSrc}
              alt={p.publication}
              title={p.publication}
              tabindex="0"
              style={`height:${Math.round(WALL_LOGO_BASE_HEIGHT * scale)}px`}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="logo-wall-item" tabindex="0" title={p.publication}>
              <span class="vh">{p.publication}</span>
              <span aria-hidden="true">{p.publication}</span>
            </span>
          );
        })}
      </div>
    </div>
  </section>

  <!-- In brief -->
  <section style="background:var(--lavender)">
    <div class="wrap">
      <div class="shead"><h2>In brief</h2></div>
      <ul class="checklist">
        {inBrief.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </section>

  <!-- Featured: Digital News Asia -->
  <section>
    <div class="wrap">
      <div class="shead"><h2>Featured</h2></div>
      <article class:list={['featured-card', { 'has-thumb': !!featuredThumb }]}>
        {featuredThumb && (
          <div class="featured-thumb">
            <img src={featuredThumb} width="800" height="600" alt="" aria-hidden="true" loading="eager" decoding="async" />
          </div>
        )}
        <div class="featured-body">
          <span class="logo-wall-item featured-wordmark" aria-hidden="true">{dnaItem.publication}</span>
          <blockquote class="dna-quote">
            <p>&ldquo;{dnaQuote}&rdquo;</p>
            <p class="dna-attribution">{dnaItem.publication}, {formatDate(dnaItem.date)}</p>
          </blockquote>
          <a class="featured-link" href={dnaItem.href} target="_blank" rel="noopener">Read on Digital News Asia</a>
        </div>
      </article>
    </div>
  </section>

  <!-- All coverage -->
  <section style="background:var(--lavender)">
    <div class="wrap">
      <div class="shead"><h2>All coverage</h2></div>
      <p class="section-note">
        Founder appearances are interviews in which Alvin Koay speaks on AI search but Zicy is not
        named.
      </p>

      <div class="filter-row">
        <div class="filter-group" role="group" aria-label="Filter coverage by type" data-media-filter-group>
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          <button type="button" data-filter="article" aria-pressed="false">Articles</button>
          <button type="button" data-filter="podcast" aria-pressed="false">Podcasts</button>
        </div>
        <p class="filter-count" aria-live="polite">
          <span data-media-count>{coverage.length} of {coverage.length}</span>
        </p>
      </div>

      <div class="media-grid">
        {sortedCoverage.map((p) => {
          const displayHeadline = DISPLAY_HEADLINES[p.href] ?? p.headline;
          const hasOverride = displayHeadline !== p.headline;
          const thumbSrc = effectiveThumb(p);
          return (
            <article class:list={['media-card', { 'has-thumb': !!thumbSrc }]} data-media-card={p.type.toLowerCase()}>
              {thumbSrc && (
                <div class="media-thumb">
                  <img src={thumbSrc} width="800" height="600" alt="" aria-hidden="true" loading="lazy" decoding="async" />
                </div>
              )}
              <div class="media-body">
                <div class="chip-row">
                  <span class="badge">{p.type}</span>
                  {p.scope === 'founder' && <span class="badge">Founder appearance</span>}
                </div>
                <p class="media-meta">{p.publication} &middot; {formatDate(p.date)}</p>
                <h3 class="media-headline">
                  <a
                    class="card-link"
                    href={p.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={hasOverride ? p.headline : undefined}
                  >
                    {displayHeadline}
                    <svg class="ext-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path fill="currentColor" d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z" />
                      <path fill="currentColor" d="M5 5h6v2H7v10h10v-4h2v6H5V5z" />
                    </svg>
                    <span class="vh"> (opens in a new tab)</span>
                  </a>
                </h3>
                <p class="media-summary">{p.summary}</p>
                {p.programme && <p class="media-programme">{p.programme}</p>}
              </div>
            </article>
          );
        })}
      </div>

      <p style="margin-top:24px">
        More on Zicy's founder: <a href="/about/alvin-koay">Alvin Koay, founder and CEO</a>.
      </p>
    </div>
  </section>

  <script>
    const group = document.querySelector('[data-media-filter-group]');
    if (group) {
      const buttons = [...group.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
      const cards = [...document.querySelectorAll<HTMLElement>('[data-media-card]')];
      const countEl = document.querySelector('[data-media-count]');
      const total = cards.length;

      const applyFilter = (filter: string) => {
        let visible = 0;
        cards.forEach((card) => {
          const match = filter === 'all' || card.dataset.mediaCard === filter;
          card.hidden = !match;
          if (match) visible += 1;
        });
        if (countEl) countEl.textContent = `${visible} of ${total}`;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      };

      buttons.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filter || 'all')));
    }
  </script>

  <!-- Media kit -->
  <section id="media-kit">
    <div class="wrap">
      <div class="shead"><h2>Media kit</h2></div>

      <div class="kit-list">
        <div class="kit-row">
          <span class="kit-label">Logo pack</span>
          <div class="kit-links">
            {logoPack.map((f) => <a href={f.href} download>{f.label}</a>)}
          </div>
        </div>

        <div class="kit-row">
          <span class="kit-label">Brand colours</span>
          <div class="kit-swatches" data-copy-swatches>
            {brandColours.map((c) => (
              <button type="button" class="swatch" data-copy-value={c.hex} style={`--sw:${c.hex}`}>
                <span class="swatch-dot" aria-hidden="true"></span>
                <span class="swatch-text">{c.name} <span class="mono">{c.hex}</span></span>
              </button>
            ))}
          </div>
        </div>

        <div class="kit-row">
          <span class="kit-label">Founder headshot</span>
          <div class="kit-links">
            <a href={headshotHref} download>Alvin Koay, high resolution (PNG)</a>
          </div>
        </div>

        <div class="kit-row">
          <span class="kit-label">Product screenshots</span>
          <div class="kit-links">
            {screenshotsExist ? null : (
              <span class="kit-muted">Available on request &middot; <a href="#press-enquiries">contact press</a></span>
            )}
          </div>
        </div>
      </div>

      <div class="boilerplate-block">
        <h3>Boilerplate</h3>
        <p class="boilerplate-text">
          Withheld. Two clauses in the supplied paragraph, identifies content gaps and
          restructures web content so it can be retrieved and cited, are not backed by a generic
          Zicy product claim anywhere on the site. See the build report for what was checked.
        </p>
      </div>
    </div>
  </section>

  <!-- Press enquiries -->
  <section id="press-enquiries" style="background:var(--lavender)">
    <div class="wrap">
      <div class="shead"><h2>Press enquiries</h2></div>
      <p class="press-contact">
        <a href="mailto:privacy@zicy.com">privacy@zicy.com</a><br />
        We reply within two working days.
      </p>
      <address class="press-address">
        60 Persiaran Midlands<br />
        10250 Penang, Malaysia<br />
        {/* No timezone string exists anywhere in this repo (checked Footer.astro and the whole
            tree); this is supplied from general public knowledge of Malaysia's single, non-DST
            zone, not taken from any site content. Flagged in the build report. */}
        Malaysia Time (GMT+8)
      </address>
    </div>
  </section>

  <!-- Closing CTA -->
  <CtaBand
    heading="See how AI answers describe your brand"
    sub="Zicy tracks your share of voice, citations, positioning and sentiment across ChatGPT, Gemini, Perplexity, Google AI Overviews and Google AI Mode."
    ctaLabel={freeTrialLabel}
    ctaHref={freeTrialHref}
  />
  <div class="cta-secondary-wrap">
    <a href="/case-studies">Case studies</a>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy-value]').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('.swatch-text, [data-copy-label]');
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copyValue || '';
        try {
          await navigator.clipboard.writeText(value);
          if (label) {
            const original = label.textContent;
            label.textContent = 'Copied';
            setTimeout(() => { if (original) label.textContent = original; }, 1200);
          }
        } catch {
          /* clipboard unavailable; label still shows the intended value as plain text */
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin-bottom:18px}
  .crumbs a{color:var(--muted)}
  .crumbs a:hover{color:var(--indigo)}
  .crumbs .sep{color:var(--line-2)}
  .crumbs .here{color:var(--ink)}

  .dek{margin-top:16px;font-size:19px;color:var(--ink-2);max-width:640px;line-height:1.5}
  .proof-line{margin-top:14px;font-family:var(--mono);font-size:13px;letter-spacing:.02em;color:var(--muted)}
  .hero-links{display:flex;gap:20px;margin-top:22px}
  .hero-links a{font-size:14.5px;font-weight:500;color:var(--indigo)}
  .hero-links a:hover{color:var(--indigo-bright)}

  /* Publisher logo wall: real logo images (falls back to a text wordmark only when a publisher
     has no file under public/press/), greyscale at rest via reduced opacity + grayscale filter,
     full colour on hover/focus. .logo-wall-item carries the shared treatment for both; .logo-wall-img
     resets img-specific defaults and sizes by height only (width auto) so aspect ratio is never
     distorted — the per-publisher height itself comes from the inline style (LOGO_SCALE). */
  .logo-wall-section{padding-top:0}
  .logo-wall{display:flex;flex-wrap:wrap;gap:14px 28px;align-items:center}
  .logo-wall-item{
    font-family:var(--display);font-weight:500;font-size:17px;letter-spacing:-0.01em;
    color:var(--muted);opacity:.65;filter:grayscale(1);
