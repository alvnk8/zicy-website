---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { webPageSchema, ORG_ID, PERSON_IDS } from '../lib/schema';

const title = 'Zicy in the press';
const description =
  'Press coverage naming Zicy, and media appearances by founder Alvin Koay, verified against the publisher’s own page for each item.';

// DNA sentence reproduced exactly as recorded in the verified media-source evidence. Never reword.
const dnaQuote =
  "To address this very gap in the market, GrowthPro built Zicy, an AI-powered platform that tracks share of voice, citation volume, positioning and sentiment across five major answer engines, and uses an AI agent to identify content gaps and restructure website content for LLM retrieval.";
const dnaHref =
  'https://www.digitalnewsasia.com/business/growthpros-alvin-koay-googles-ai-has-rewritten-rules-search';
const dnaDate = 'July 12, 2026';

// Coverage naming Zicy (verified YES in _cc-media-sources.md), newest first.
const coverage = [
  {
    publication: 'Digital News Asia',
    date: 'July 12, 2026',
    headline: "GrowthPro's Alvin Koay: Google's AI has rewritten the rules of search",
    summary:
      "Alvin explains how Google's AI Overviews and AI Mode have cut into publisher and brand traffic, and introduces Zicy as the platform GrowthPro built to track share of voice, citation volume, positioning and sentiment across the major answer engines.",
    href: dnaHref,
  },
  {
    publication: 'Biz.bio',
    date: 'March 18, 2026',
    headline: 'Alvin Koay and Zicy: Rebuilding in the Age of AI',
    summary:
      "A founder profile tracing Alvin's path from an early ad-tech startup through Growth.pro to building Zicy, the system he built to help brands become visible inside AI-generated answers.",
    href: 'https://biz.bio/founders/alvin-koay-and-zicy-rebuilding-in-the-age-of-ai/',
  },
  {
    publication: 'e27',
    date: '16 March 2026',
    headline: 'The new growth metric: AI Share of Voice',
    summary:
      'Alvin argues that AI Share of Voice and citation authority are becoming the metrics that matter more than traffic, as AI answers replace clicks.',
    href: 'https://e27.co/the-new-growth-metric-ai-share-of-voice-20260316/',
  },
  {
    publication: 'e27',
    date: '12 March 2026',
    headline: 'Your biggest competitor might be the AI answer itself',
    summary:
      'Alvin explains why AI answer engine optimisation is becoming a strategic necessity for startups, and how being cited by AI is starting to decide who gets considered at all.',
    href: 'https://e27.co/your-biggest-competitor-might-be-the-ai-answer-itself-20260312/',
  },
  {
    publication: 'Malaysia SME+',
    date: null,
    headline:
      "Answer Engines such as CHATGPT, GEMINI, GOOGLE's AI Mode are your customers' new best friends – businesses must align web pages and online presence or risk losing leads and revenue generation channels.",
    summary:
      'Alvin walks through why answer engine optimisation is replacing traditional SEO, and what businesses need to restructure in their content and schema to stay discoverable.',
    href: 'https://www.malaysiasme.com.my/answer-engines-such-as-chatgpt-gemini-googles-ai-mode-are-your-customers-new-best-friends-businesses-must-align-web-pages-and-online-presence-or-risk-losing-leads-and-revenue-generatio/',
  },
];

// Alvin Koay in the media (verified NO in _cc-media-sources.md, Zicy not named), newest first.
const founderMedia = [
  {
    programme: 'Open For Business (BFM 89.9)',
    date: '3 March 2026',
    headline: 'The Growthpro Strategy to Combat Traditional SEOs',
    summary:
      'Alvin discusses how Growth.pro sells visibility inside AI systems rather than rankings and traffic, and how the agency runs and differentiates itself in a crowded market.',
    href: 'https://www.bfm.my/content/podcast/the-growthpro-strategy-to-combat-traditional-seos',
  },
  {
    programme: 'Marketing Mojo (BFM 89.9)',
    date: '10 February 2026',
    headline: 'Is SEO Dead? The AI Search Shake-Up',
    summary:
      'Alvin discusses how AI tools are changing search behaviour and why traditional SEO metrics are losing relevance for Malaysian marketing teams.',
    href: 'https://www.bfm.my/content/podcast/is-seo-dead-the-ai-search-shake-up',
  },
];
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webPageSchema('/media', title, ORG_ID, PERSON_IDS.alvin))} />

  <!-- Hero -->
  <section class="hero inner">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">&rsaquo;</span>
        <span class="here" aria-current="page">Media</span>
      </nav>
      <span class="eyebrow">Media</span>
      <h1>Zicy in the press</h1>
      <blockquote class="dna-quote">
        <p>&ldquo;{dnaQuote}&rdquo;</p>
        <footer>
          Digital News Asia, {dnaDate} &middot; see the full coverage below
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- Coverage naming Zicy -->
  <section style="background:var(--lavender)">
    <div class="wrap">
      <div class="shead"><h2>Coverage naming Zicy</h2></div>
      <div class="press-list">
        {coverage.map((p) => (
          <article class="press-item">
            <p class="press-meta">
              {p.publication}{p.date ? <> &middot; {p.date}</> : null}
            </p>
            <h3><a href={p.href} target="_blank" rel="noopener">{p.headline}</a></h3>
            <p class="press-summary">{p.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Alvin Koay in the media -->
  <section>
    <div class="wrap">
      <div class="shead"><h2>Alvin Koay in the media</h2></div>
      <p class="section-note">
        These are appearances by Zicy's founder, Alvin Koay, in which Zicy itself is not named.
      </p>
      <div class="press-list">
        {founderMedia.map((p) => (
          <article class="press-item">
            <p class="press-meta">{p.programme} &middot; {p.date}</p>
            <h3><a href={p.href} target="_blank" rel="noopener">{p.headline}</a></h3>
            <p class="press-summary">{p.summary}</p>
          </article>
        ))}
      </div>
      <p style="margin-top:24px">
        More on Zicy's founder: <a href="/about/alvin-koay">Alvin Koay, founder and CEO</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin-bottom:18px}
  .crumbs a{color:var(--muted)}
  .crumbs a:hover{color:var(--indigo)}
  .crumbs .sep{color:var(--line-2)}
  .crumbs .here{color:var(--ink)}

  .dna-quote{margin-top:22px;padding:22px 24px;background:var(--lavender);border:0.5px solid var(--line);border-radius:14px;max-width:820px}
  .dna-quote p{font-family:var(--display);font-size:clamp(18px,2.1vw,22px);line-height:1.5;color:var(--ink);letter-spacing:-0.01em}
  .dna-quote footer{margin-top:10px;font-size:13.5px;color:var(--muted)}
  .dna-quote footer a{color:var(--indigo)}
  .dna-quote footer a:hover{color:var(--indigo-bright)}

  .section-note{max-width:760px;font-size:14.5px;color:#4a4960;margin-bottom:20px}

  .press-list{display:grid;gap:18px;max-width:760px}
  .press-item{padding:20px 22px;background:#fff;border:0.5px solid var(--line);border-radius:14px}
  .press-meta{
    font-family:var(--mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--orange);margin-bottom:8px;font-weight:500;
  }
  .press-item h3{font-family:var(--display);font-size:19px;line-height:1.4;margin-bottom:8px;letter-spacing:-0.01em}
  .press-item h3 a{color:var(--indigo)}
  .press-item h3 a:hover{color:var(--indigo-bright)}
  .press-summary{font-size:14.5px;color:#4a4960;line-height:1.6}
</style>
