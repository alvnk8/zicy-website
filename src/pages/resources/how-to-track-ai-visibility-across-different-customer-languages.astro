import promptManagerImg from '../../assets/resources/track-ai-visibility-across-customer-languages/prompt-manager-language-tracking.png';

const metaTitle = 'How to Track AI Visibility Across Different Customer Languages';
const title = 'How to Track AI Visibility Across Different Customer Languages';
const description = 'Learn how to track AI visibility across customer languages, build multilingual prompts and uncover brand, citation and competitor gaps hidden by English-only tracking.';
const url = `${SITE.url}/resources/how-to-track-ai-visibility-across-different-customer-languages`;
const author = { '@type': 'Person', name: 'Ritu Khanna' };
const orgId = `${SITE.url}/#org`;
