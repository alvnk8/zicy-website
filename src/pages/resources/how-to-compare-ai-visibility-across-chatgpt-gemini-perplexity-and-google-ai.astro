const metaTitle = 'How to Compare Your AI Visibility Across ChatGPT, Gemini, Perplexity & Google AI';
const title = 'How to Compare Your AI Visibility Across ChatGPT, Gemini, Perplexity and Google AI';
const description = 'Learn how to compare your AI visibility across ChatGPT, Gemini, Perplexity and Google AI using mentions, citations, rankings and Share of Voice.';
const url = `${SITE.url}/resources/how-to-compare-ai-visibility-across-chatgpt-gemini-perplexity-and-google-ai`;
const author = { '@type': 'Person', name: 'Ritu Khanna' };
const orgId = `${SITE.url}/#org`;
