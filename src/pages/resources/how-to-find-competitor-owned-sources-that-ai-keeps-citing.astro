  .answer{max-width:720px;margin:18px 0 0;padding:18px 20px;background:var(--mist);border:0.5px solid var(--line);border-left:3px solid var(--indigo);border-radius:12px;font-size:17px;line-height:1.6;color:var(--ink)}.byline{margin-top:16px;font-size:14px;color:var(--muted)}
  .prose{max-width:760px}.prose ol,.prose ul{margin:0 0 16px;padding-left:22px;line-height:1.6}.prose li{margin-bottom:6px}.prose h3{margin:28px 0 10px;color:var(--ink);font-size:21px}
  .prompt{max-width:700px;margin:16px 0;padding:16px 20px;background:var(--lavender);border:0.5px solid var(--line);border-radius:12px;color:var(--ink);font-size:17px;line-height:1.55}
  .table-wrap{max-width:760px;overflow-x:auto;margin:24px 0}.table-wrap table{width:100%;border-collapse:collapse;background:#fff;font-size:15px}.table-wrap th,.table-wrap td{padding:13px 15px;border:1px solid var(--line);text-align:left;vertical-align:top}.table-wrap th{background:var(--lavender);color:var(--ink);font-weight:700}.table-wrap tbody tr:nth-child(even){background:var(--mist)}
