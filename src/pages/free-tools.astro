---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webPageSchema } from '../lib/schema';

const title = 'Zicy free tools: AI brand audit & Chrome extension';
const description =
  'Two free ways to see how AI reads your brand: a free AI brand audit and a browser extension. Or ask Zicy, the chat in the corner of every page.';

const tools = [
  { eyebrow: 'AI brand audit', h: 'Your free AI brand audit', p: 'Checks what four AI engines say about your brand against the facts, free.', link: 'Run my free audit →', href: '/ai-brand-audit' },
  { eyebrow: 'Chrome extension', h: 'Audit any page in your browser', p: 'Instant AI-readiness score, AI bot-access checker, and one-click schema generator. Free.', link: 'See the extension →', href: '/chrome-extension' },
];
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webPageSchema('/free-tools', title))} />
  <section class="hero inner">
    <div class="wrap">
      <span class="eyebrow">Free tools</span>
      <h1>Try Zicy before you commit.</h1>
      <p class="lead">Two free ways to see how AI reads your brand: a free AI brand audit and a browser extension. Or ask Zicy, the chat in the corner of every page.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="shead"><span class="eyebrow"><span class="ix">01</span> Pick a tool</span><h2>Two ways in.</h2></div>
      <div class="grid-2">
        {tools.map((t) => (
          <div class="card">
            <span class="eyebrow">{t.eyebrow}</span>
            <h3>{t.h}</h3>
            <p>{t.p}</p>
            <a class="link" href={t.href}>{t.link}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
