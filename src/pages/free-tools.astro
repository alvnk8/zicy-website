---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { webPageSchema, ORG_ID } from '../lib/schema';

const title = 'Zicy free tools, AEO/GEO Consultant & Chrome extension';
const description =
  'Two free ways to see how AI reads your brand: the AEO/GEO Consultant and a browser extension.';

const tools = [
  { eyebrow: 'AI consultant', h: 'AEO/GEO Consultant', p: 'Ask anything about AEO or GEO, or audit a page on the spot. Powered by Growth.pro’s proprietary framework.', link: 'Open the consultant →', href: '/consultant' },
  { eyebrow: 'Chrome extension', h: 'Audit any page in your browser', p: 'Instant AI-readiness score, AI bot-access checker, and one-click schema generator. Free.', link: 'See the extension →', href: '/chrome-extension' },
];

// CollectionPage for the two free-tool entries above, naming each tool's own entity node
// (consultant's Service, the Chrome extension's SoftwareApplication) rather than re-describing them.
const collectionUrl = `${SITE.url}/free-tools`;
const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${collectionUrl}#collection`,
  url: collectionUrl,
  name: title,
  isPartOf: { '@id': `${SITE.url}/#site` },
  about: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, item: { '@id': `${SITE.url}/consultant#service` } },
      { '@type': 'ListItem', position: 2, item: { '@id': `${SITE.url}/chrome-extension#extension` } },
    ],
  },
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webPageSchema('/free-tools', title))} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(collectionPage)} />
  <section class="hero inner">
    <div class="wrap">
      <span class="eyebrow">Free tools</span>
      <h1>Try Zicy before you commit.</h1>
      <p class="lead">Two free ways to see how AI reads your brand, an AI consultant and a browser extension.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="shead"><span class="eyebrow"><span class="ix">01</span> Pick a tool</span><h2>Two ways in.</h2></div>
      <div class="grid-2">
        {tools.map((t) => (
          <div class="card">
            <span class="eyebrow">{t.eyebrow}</span>
            <h3>{t.h}</h3>
            <p>{t.p}</p>
            <a class="link" href={t.href}>{t.link}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
